# Dependencies & build output
node_modules/
dist/
dist-lib/
build/
*.tsbuildinfo

# Test artifacts
coverage/
test-results/
playwright-report/

# Assets — sprites, audio, fonts and any generated/binary-adjacent files.
# Prettier has no business reformatting these (and may corrupt non-text formats).
assets/
public/

# Lockfiles are generated; leave them as the tool writes them.
package-lock.json

# Prose docs (AGENTS.md, ARCHITECTURE.md, CONTEXT.md, README.md, docs/…). Prettier's
# markdown pass only rewrites emphasis markers and table padding in hand-edited
# text, so the gate covers code + config, not prose (#308). `format`/`format:check`
# both run over `.`, so this file is the single source of what is gated.
*.md
